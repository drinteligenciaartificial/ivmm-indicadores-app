generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Indicator {
  id                    String         @id @default(cuid())
  code                  String         @unique
  name                  String
  area                  String
  responsiblePrimary    String         @default("Coordenação Administrativa")
  responsibleSecondary  String?
  status                String         @default("ATIVO")
  bscPerspective        String
  strategicObjective    String
  linkedProject         String?
  organizationalGoal    String?
  type                  String
  level                 String
  polarity              String
  unit                  String
  collectionFrequency   String         @default("MENSAL")
  analysisFrequency     String         @default("MENSAL")
  purpose               String
  operationalDefinition String
  relevance             String?
  limitations           String?
  formula               String
  numerator             String?
  denominator           String?
  inclusionCriteria     String?
  exclusionCriteria     String?
  sourceSystem          String
  storageLocation       String?
  collectionMethod      String
  collectionOwner       String         @default("Coordenação Administrativa")
  evidence              String?
  isAiEligible          Boolean        @default(false)
  isAiIntegrable        Boolean        @default(false)
  dashboardName         String?
  aiAgentName           String?
  dataReliability       String         @default("Médio")
  requiresAudit         Boolean        @default(true)
  auditFrequency        String?
  okrs                  OkrIndicator[]
  goals                 Goal[]
  results               Result[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Goal {
  id           String    @id @default(cuid())
  indicatorId  String
  indicator    Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  year         Int
  quarter      Int?
  month        Int?
  targetValue  Float
  alertValue   Float?
  minimumValue Float?
  idealValue   Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([indicatorId, year, quarter, month])
}

model Result {
  id            String    @id @default(cuid())
  indicatorId   String
  indicator     Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  referenceDate DateTime
  actualValue   Float
  targetValue   Float
  achievement   Float
  trafficLight  String
  analysis      String?
  actionPlan    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([indicatorId, referenceDate])
}

model Okr {
  id         String         @id @default(cuid())
  title      String
  objective  String
  area       String
  year       Int
  quarter    Int?
  owner      String
  indicators OkrIndicator[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model OkrIndicator {
  id          String    @id @default(cuid())
  okrId       String
  indicatorId String
  weight      Float     @default(1)
  okr         Okr       @relation(fields: [okrId], references: [id], onDelete: Cascade)
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([okrId, indicatorId])
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        String
  permissions String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String?
  action    String
  summary   String
  actorName String
  actorRole String
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
}

model IntegrationConnection {
  id             String              @id @default(cuid())
  provider       String              @unique
  status         String              @default("DESCONECTADO")
  subdomain      String?
  accountId      String?
  accountName    String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  lastSyncAt     DateTime?
  lastError      String?
  records        ExternalCrmRecord[]
  syncs          IntegrationSync[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model ExternalCrmRecord {
  id                String                @id @default(cuid())
  integrationId     String
  integration       IntegrationConnection @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  entityType        String
  externalId        String
  name              String?
  pipelineId        String?
  statusId          String?
  responsibleUserId String?
  monetaryValue     Float?
  sourceCreatedAt   DateTime?
  sourceUpdatedAt   DateTime?
  payload           String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([integrationId, entityType, externalId])
  @@index([integrationId, entityType, sourceUpdatedAt])
}

model IntegrationSync {
  id            String                @id @default(cuid())
  integrationId String
  integration   IntegrationConnection @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  status        String
  importedCount Int                   @default(0)
  errorMessage  String?
  startedAt     DateTime              @default(now())
  finishedAt    DateTime?

  @@index([integrationId, startedAt])
}

model RecruitmentPosition {
  id                  String                 @id @default(cuid())
  code                String                 @unique
  title               String
  department          String
  managerName         String?
  status              String                 @default("ATIVO")
  mission             String
  description         String
  responsibilities    String
  hardSkills          String
  softSkills          String
  tools               String?
  education           String?
  experience          String?
  behavioralProfile   String?
  culturalValues      String
  eliminatoryCriteria String?
  desirableCriteria   String?
  remunerationRange   String?
  workModel           String?
  schedule            String?
  competencyWeights   String                 @default("{}")
  vacancies           RecruitmentVacancy[]
  candidates          RecruitmentCandidate[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model RecruitmentVacancy {
  id             String                 @id @default(cuid())
  code           String                 @unique
  title          String
  department     String
  positionId     String
  position       RecruitmentPosition    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  status         String                 @default("ABERTA")
  openings       Int                    @default(1)
  managerName    String?
  openedAt       DateTime               @default(now())
  closedAt       DateTime?
  summary        String?
  candidates     RecruitmentCandidate[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model RecruitmentCandidate {
  id                    String                    @id @default(cuid())
  name                  String
  email                 String                    @unique
  phone                 String?
  source                String?
  status                String                    @default("ATIVO")
  stage                 String                    @default("INSCRICAO")
  vacancyId             String?
  vacancy               RecruitmentVacancy?       @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  positionId            String?
  position              RecruitmentPosition?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  resumeText            String?
  professionalSummary   String?
  curriculumScore       Float                     @default(0)
  iacScore              Float                     @default(0)
  ipdScore              Float                     @default(0)
  sceScore              Float                     @default(0)
  qualityOfHireScore    Float?
  decision              String?
  decisionJustification String?
  tags                  String?
  stageHistory          RecruitmentStageHistory[]
  evaluations           RecruitmentEvaluation[]
  assessments           RecruitmentAssessment[]
  aiAnalyses            RecruitmentAiAnalysis[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([stage, status])
  @@index([vacancyId])
}

model RecruitmentStageHistory {
  id          String               @id @default(cuid())
  candidateId String
  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage       String
  notes       String?
  actorName   String
  createdAt   DateTime             @default(now())

  @@index([candidateId, createdAt])
}

model RecruitmentEvaluation {
  id            String               @id @default(cuid())
  candidateId   String
  candidate     RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type          String
  evaluatorName String
  competency    String?
  score         Float                @default(0)
  evidence      String
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([candidateId, type])
}

model RecruitmentAssessment {
  id            String               @id @default(cuid())
  candidateId   String
  candidate     RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  exercise      String
  evaluatorName String
  score         Float                @default(0)
  evidence      String
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([candidateId])
}

model RecruitmentAiAnalysis {
  id            String               @id @default(cuid())
  candidateId   String
  candidate     RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  analysisType  String
  promptVersion String
  model         String
  contextUsed   String
  result        String
  humanFeedback String?
  status        String               @default("PENDENTE_AVALIACAO_HUMANA")
  requestedBy   String
  createdAt     DateTime             @default(now())

  @@index([candidateId, analysisType])
}
